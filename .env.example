# Copie para .env (git-ignored) e preencha se quiser que o config-server no
# docker-compose use o backend git (repo privado walletzen-repository).
# Por padrao o compose usa o backend 'native' e nada disso e necessario.

CONFIG_SERVER_PROFILE=git
GIT_USERNAME=Ismadrade
GIT_PASSWORD=seu-personal-access-token
