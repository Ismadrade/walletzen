# Copie para .env (git-ignored) e preencha se quiser que o config-server no
# docker-compose use o backend git (repo privado walletzen-repository).
# Por padrao o compose usa o backend 'native' e nada disso e necessario.

CONFIG_SERVER_PROFILE=git
GIT_USERNAME=Ismadrade
GIT_PASSWORD=seu-personal-access-token

# Keycloak — admin do master (console em http://localhost:8080). Opcional; default admin/admin.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin

# Secret do client wz-user-service (o wz-user usa para provisionar usuários no Keycloak).
# Default no realm importado = wz-user-service-secret; troque em ambiente real.
WZ_USER_KC_SECRET=wz-user-service-secret
