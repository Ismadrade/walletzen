{
  "realm": "walletzen",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Usuário padrão do WalletZen" },
      { "name": "ADMIN", "description": "Administrador do WalletZen" }
    ]
  },
  "clients": [
    {
      "clientId": "walletzen-app",
      "name": "WalletZen App / API",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "*" ],
      "webOrigins": [ "*" ],
      "attributes": {
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "wz-user-service",
      "name": "wz-user service account (provisiona usuários no Keycloak)",
      "enabled": true,
      "publicClient": false,
      "secret": "wz-user-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@walletzen.local",
      "firstName": "Alice",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "realmRoles": [ "USER" ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "ismael.andrade@walletzen.com.br",
      "firstName": "Ismael",
      "lastName": "Andrade",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": [ "USER", "ADMIN" ]
    },
    {
      "username": "service-account-wz-user-service",
      "enabled": true,
      "serviceAccountClientId": "wz-user-service",
      "clientRoles": {
        "realm-management": [ "manage-users", "view-users", "view-realm" ]
      }
    }
  ]
}
